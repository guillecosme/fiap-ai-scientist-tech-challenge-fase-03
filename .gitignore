# Python
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/

# Ambientes virtuais
.venv/
venv/

# uv
.uv-cache/

# Editor / IDE
.idea/
.vscode/
*.swp
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Dados brutos e externos: baixados por `make data`, pesados demais para versionar
data/raw/*
data/external/*
!data/raw/.gitkeep
!data/external/.gitkeep
# a malha municipal (3,6 MB) fica versionada para os mapas rodarem sem download
!data/external/ibge/
data/external/ibge/*
!data/external/ibge/malha_municipios.json

# A Gold e as bases analiticas sao versionadas de proposito: deixam os notebooks
# e os modelos reproduziveis sem baixar nada. Os arquivos maiores (fato_aluno e a
# base de aluno) ficam em torno de 25 MB em Parquet comprimido, o que cabe no git.

# Modelos: os pipelines finais sao versionados; artefatos intermediarios nao
models/tmp/

# Logs e temporarios
*.log
tmp/
.pytest_cache/
.ruff_cache/

# Variaveis de ambiente locais
.env
